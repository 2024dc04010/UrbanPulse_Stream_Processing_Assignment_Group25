# UrbanPulse Task C — Custom Flink Image
# Extends flink:1.18 with:
#   - Python 3 + PyFlink 1.18.0
#   - Flink Kafka connector 3.1.0
#   - Kafka clients 3.4.0

FROM flink:1.18-scala_2.12

# Install Python 3 and pip
RUN apt-get update && \
    apt-get install -y python3 python3-pip wget && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    rm -rf /var/lib/apt/lists/*

# Install PyFlink (must match the Flink server version)
RUN pip3 install "apache-flink==1.18.0"

# Download Flink Kafka connector JARs into Flink's lib dir so they are auto-loaded
RUN wget -q -P /opt/flink/lib/ \
    https://repo1.maven.apache.org/maven2/org/apache/flink/flink-connector-kafka/3.1.0-1.18/flink-connector-kafka-3.1.0-1.18.jar && \
    wget -q -P /opt/flink/lib/ \
    https://repo1.maven.apache.org/maven2/org/apache/kafka/kafka-clients/3.4.0/kafka-clients-3.4.0.jar

# Verify installs
RUN python3 -c "import pyflink; print('PyFlink OK:', pyflink.__version__)"
RUN ls /opt/flink/lib/flink-connector-kafka*.jar
